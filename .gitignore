# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific export presets can hold keystore paths / passwords
export_presets.cfg

# Build output
/build/
/exports/
*.translation

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# Local-only scratch
/_local/
/_tmp/
/_shot_*.png
/_capture.ps1

# Fonts are fetched, not committed — see assets/fonts/README.md
/assets/fonts/*.ttf
/assets/fonts/*.otf
